{
  "name": "embedded_ins_daq",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/embedded_ins_daq",
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "runArgs": [
    "--device-cgroup-rule=c 166:* rmw",
    "--device-cgroup-rule=c 188:* rmw",
    "--group-add=20"
  ],
  "containerEnv": {
    "IDF_PATH": "/opt/esp/idf",
    "BOARD_PORT": "/dev/ttyACM0"
  },
  "mounts": [
    "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind",
    "source=${localEnv:HOME}/.dotfile/gitconfig,target=/home/vscode/.gitconfig,type=bind,readonly",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,readonly",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly"
  ],
  // Install dev extensions:
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "openai.chatgpt",
        "github.vscode-pull-request-github",
        "eamodio.gitlens",
        "timonwong.shellcheck",
        "mermaidchart.vscode-mermaid-chart"
      ]
    }
  },
}
